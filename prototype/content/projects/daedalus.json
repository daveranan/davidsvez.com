    {
      "id": "daedalus-journey",
      "type": "text",
      "width": "full",
      "heading": "Building a coherent narrative world",
      "body": "Daedalus began as Estafos & Suraya: a test of whether a small team could turn generated source imagery into a coherent narrative project.\n\nI wrote the story and built the world, generated 9,000 source images, and selected and edited the material into a 12-page comic. I assembled the layouts in Figma, animated 12 panels in Rive, and helped build an interactive web reader with a licensed soundtrack. The world expanded into a website, brand, merchandise, and live-action film work with collaborators.",
      "source": "",
      "mediaRef": "",
      "href": "",
      "label": "",
      "projectId": "",
      "alt": "",
      "fit": "cover"
    },
