{"id":"dronies","parentId":null,"showOnRoot":false,"layout":"folder","windowWidth":"748px","windowHeight":"506px","textWidth":"62ch","body":"","showOverview":true,"showFolderActions":true,"blocks":[{"id":"dronies-hero","type":"youtube","width":"full","heading":"Project breakdown","body":"","source":"https://www.youtube.com/watch?v=frDa98oOi8s","mediaRef":"","href":"","label":"","projectId":"","alt":"Dronies project breakdown","fit":"cover"},{"id":"dronies-journey","type":"text","width":"full","heading":"Connecting a multidisciplinary production","body":"Dronies required a consistent direction across collection art, product, web, story, comics, merchandise, and launch creative. I worked as creative director, art director, and producer across the project.\n\nMy work combined hands-on design with communication between artists, designers, developers, marketing, community, operations, and external partners. That included coordination with the Solana Labs team around the partnership.\n\nThe work was collaborative. My contribution was setting direction, producing key pieces, and coordinating the disciplines and people involved.","source":"","mediaRef":"","href":"","label":"","projectId":"","alt":"","fit":"cover"},{"id":"dronies-transition","type":"video","width":"full","heading":"","body":"","source":"assets/media/optimized/Projects/Dronies/dronies_graphic.mp4","mediaRef":"media-dronies-dronies-graphic-mp4","href":"","label":"","projectId":"","alt":"Dronies Graphic portfolio artifact","fit":"cover","posterFrame":"assets/media/posters/media-dronies-dronies-graphic-mp4.jpg","mediaWidth":0,"mediaHeight":0,"aspectRatio":""},{"id":"dronies-scope-1","type":"image","width":"third","heading":"","body":"","source":"assets/media/optimized/Projects/Dronies/Creatives/dronies-web-hero.webp","mediaRef":"media-dronies-creatives-dronies-web-hero-png","href":"","label":"","projectId":"","alt":"Dronies Web Hero portfolio artifact","fit":"cover","posterFrame":"","mediaWidth":0,"mediaHeight":